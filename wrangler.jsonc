{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yasmin-ai-studio",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public"
  },

  // Cloudflare automatic provisioning:
  // D1, R2 e KV serão criados/vinculados automaticamente no primeiro deploy.
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],

  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "vars": {
    "ENVIRONMENT": "production",
    "FREE_FIRST_MODE": "true",
    "TEXT_AI_MODEL": "@cf/meta/llama-3.2-3b-instruct"
  },

  "triggers": {
    "crons": ["*/15 * * * *"]
  }

  // Secrets continuam fora deste arquivo e devem ser configurados no Cloudflare:
  // ADMIN_PASSWORD_HASH
  // JWT_SECRET
  // OPENAI_API_KEY (opcional)
  // GOOGLE_API_KEY (opcional)
  // REPLICATE_API_TOKEN (opcional)
  // FAL_API_KEY (opcional)
  // STABILITY_API_KEY (opcional)
}
