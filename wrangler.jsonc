{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yasmin-trend-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "CAROUSEL_SIZE": "3",
    "CONTENT_REGION": "BR",
    "DASHBOARD_ORIGIN": "https://yasmin-trend-studio.pedrolord152.chatgpt.site",
    "IMAGE_MODEL": "@cf/black-forest-labs/flux-2-dev",
    "META_GRAPH_VERSION": "v26.0",
    "TIKTOK_TREND_FEED_URL": "https://ads.tiktok.com/business/creativecenter/inspiration/popular/hashtag/pc/en?period=7&region=BR",
    "VISION_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yasmin-trend-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "yasmin-trend-assets"
    }
  ],
  "workflows": [
    {
      "name": "yasmin-content-workflow",
      "binding": "CONTENT_WORKFLOW",
      "class_name": "ContentWorkflow",
      "schedules": ["0 12 * * *"]
    }
  ]
}
