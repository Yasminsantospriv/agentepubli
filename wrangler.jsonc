{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yasmin-ai-studio",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public"
  },

  "d1_databases": [
    {
      "binding": "DB"
    }
  ],

  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "vars": {
    "ENVIRONMENT": "production",
    "FREE_FIRST_MODE": "true",
    "TEXT_AI_MODEL": "@cf/meta/llama-3.2-3b-instruct",
    "IMAGE_AI_MODEL": "@cf/black-forest-labs/flux-2-klein-4b",
    "META_GRAPH_VERSION": "v25.0"
  },

  "triggers": {
    "crons": ["*/15 * * * *"]
  }

  // Secrets no painel Cloudflare → Configurações → Variáveis e segredos:
  // ADMIN_PASSWORD_HASH
  // JWT_SECRET
  // META_ACCESS_TOKEN
  // META_IG_USER_ID
  // OPENAI_API_KEY (opcional; não é necessário no modo gratuito)
  // GOOGLE_API_KEY (opcional)
  // REPLICATE_API_TOKEN (opcional)
  // FAL_API_KEY (opcional)
  // STABILITY_API_KEY (opcional)
}
