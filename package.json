{
  "name": "yasmin-ai-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Yasmin AI — Content & Automation Studio (Cloudflare Workers + D1 + R2)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute yasmin-db --local --file=./src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute yasmin-db --remote --file=./src/db/schema.sql",
    "tail": "wrangler tail",
    "dev:scheduled": "wrangler dev --test-scheduled",
    "hash:password": "node ./scripts/hash-password.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  }
}
